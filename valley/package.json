{
  "name": "brushwild",
  "private": true,
  "version": "0.2.0",
  "description": "An open-world action RPG drawn in pen and coloured pencil, entirely by shaders.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.2.8",
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "@fontsource/patrick-hand": "5.2.8",
    "@preact/signals": "2.11.4",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
